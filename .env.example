# Tests and `npm run trace` need none of this: they run on in-process Postgres with recorded replies.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/officesync_ai
REDIS_URL=redis://localhost:6379
OPENROUTER_API_KEY=
# at least 16 characters; shared with the webapp that signs sessions
SESSION_SECRET=

# The OfficeSyncPro internal API: workspace members and time zone, task creation, Graph tokens
OFFICESYNCPRO_API_URL=http://localhost:4000
OFFICESYNCPRO_API_TOKEN=
GRAPH_TOKEN_URL=http://localhost:4000/internal/graph/token

PORT=3000
