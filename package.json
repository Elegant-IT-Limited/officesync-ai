{
  "name": "officesync-ai",
  "version": "0.5.0",
  "private": true,
  "description": "AI pipeline for OfficeSyncPro: Microsoft Graph mail and Teams transcripts to reviewed tasks, summaries, reminders and meeting slots. Reference build.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Elegant-IT-Limited/officesync-ai"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "typecheck": "tsc --noEmit -p .",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "migrate": "tsx scripts/migrate.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "trace": "tsx scripts/trace.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.3.16",
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/platform-express": "11.2.6",
    "bullmq": "5.81.5",
    "drizzle-orm": "0.44.6",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "dependency-cruiser": "18.4.0",
    "jest": "30.5.2",
    "ts-jest": "29.4.13",
    "tsx": "4.23.15",
    "typescript": "5.7.3"
  }
}
